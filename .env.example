# VMD Bullion Environment Variables Template (NEVER commit real secrets)

# Production PostgreSQL (Neon Free Tier - requires TLS)
# Distinct role credentials (A3-FINAL-2): never run API/collectors as migration owner!
# DATABASE_URL=postgresql://vmd_app_runtime:<RUNTIME_PASSWORD>@ep-<endpoint>.pooler.aws.neon.tech/neondb?sslmode=require
# MIGRATION_DATABASE_URL=postgresql://vmd_migrator:<MIGRATION_PASSWORD>@ep-<endpoint>.aws.neon.tech/neondb?sslmode=require
# READONLY_DATABASE_URL=postgresql://vmd_research_readonly:<READONLY_PASSWORD>@ep-<endpoint>.pooler.aws.neon.tech/neondb?sslmode=require

# Runtime environment: development | production
ENVIRONMENT=development

# Database pooling tuning
DB_USE_NULLPOOL=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300

# Security & Authentication
AUTH_ENABLED=false
GOLDSENSE_API_KEY=replace-with-strong-random-32-char-secret
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Freshness thresholds
MJDTA_FRESH_HOURS=16.0
MJDTA_DELAYED_HOURS=36.0
KJPL_LIVE_SECONDS=120.0
KJPL_LIVE_FRESH_HOURS=4.0
KJPL_LIVE_DELAYED_HOURS=24.0

# Worker configuration (Oracle VM)
KJPL_VERIFY_INTERVAL_SEC=60
KJPL_RPANEL_REFRESH_SEC=300
KJPL_POLL_FALLBACK_SEC=5

# Frontend (Vercel)
# NEXT_PUBLIC_API_BASE_URL=https://api.vmd-bullion.example.com
