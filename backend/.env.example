# Database Connection String
# Defaults to SQLite if PostgreSQL is unavailable
DATABASE_URL=postgresql://goldsense_user:password@localhost:5432/goldsense_db

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Authorization
# Set to 'true' in production to enforce Bearer token / X-API-Key validation
AUTH_ENABLED=false
GOLDSENSE_API_KEY=change_this_to_a_secure_token_with_at_least_16_chars

# Market Refresh Cooldown (seconds)
CACHE_DEBOUNCE_SECONDS=60

# News Ingestion Lookback (hours)
NEWS_LOOKBACK_HOURS=6
