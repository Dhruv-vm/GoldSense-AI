[Unit]
Description=VMD Bullion Dedicated KJPL Live WebSocket Worker (Single-Writer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/vmd-bullion
EnvironmentFile=/etc/vmd-bullion/vmd.env
Environment="PYTHONPATH=/opt/vmd-bullion/backend"
ExecStart=/opt/vmd-bullion/backend/.venv/bin/python scripts/kjpl_live_worker.py
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
